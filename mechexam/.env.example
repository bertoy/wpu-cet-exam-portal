# Copy to .env for local use, or set these as variables on your host.
# Never commit the filled-in version.

# ---- required in production ------------------------------------------------
# Any long random string. Changing it signs everyone out.
SECRET_KEY=change-me-to-a-long-random-string

# ---- where the data lives --------------------------------------------------
# Point this OUTSIDE the program folder so a redeployment cannot erase it.
#   Railway:        /data            (mount a volume there)
#   PythonAnywhere: /home/YOURNAME/mechexam-data
#   This computer:  leave unset and it uses ./data
# DATA_DIR=/data

# ---- database --------------------------------------------------------------
# Leave unset for SQLite inside DATA_DIR (fine for one campus).
# On Railway, add a PostgreSQL service and reference its variable:
# DATABASE_URL=${{Postgres.DATABASE_URL}}

# ---- the first administrator ----------------------------------------------
# Used only when no administrator exists yet.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-on-first-sign-in
ADMIN_NAME=System Administrator

# ---- institution (appears on screen and on printed sheets) -----------------
SCHOOL_NAME=Western Philippines University
COLLEGE_NAME=College of Engineering and Technology
DEPARTMENT_NAME=Department of Mechanical Engineering
CAMPUS_NAME=Puerto Princesa Campus, Palawan
APP_NAME=WPU-CET Examination & Gradebook Portal

# ---- uploads ---------------------------------------------------------------
MAX_UPLOAD_MB=64

# ---- Google Drive (optional) ----------------------------------------------
# Paste the whole service-account JSON on one line. A service account has no
# Drive storage of its own, so either upload into a Shared drive it belongs
# to, or set GOOGLE_DRIVE_IMPERSONATE so uploads are performed as the
# instructor and land in their own Drive.
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account", ...}
# GOOGLE_DRIVE_IMPERSONATE=instructor@yourschool.edu.ph
